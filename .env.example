NODE_ENV=production
# phipster native Windows configuration
# Cloudflare Tunnel should route bibster.tallgin.com to http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://bibster.tallgin.com

# Leave DB_PATH empty to use .\data\bibster.sqlite.
# If set, relative paths are resolved from the phipster project directory.
DB_PATH=

ADMIN_KEY=change-me-to-a-long-random-string
ROOM_TTL_HOURS=6

# Used only as the contact identifier in MusicBrainz API requests for Solo release-year auditing.
# A public project URL or contact email is appropriate. Defaults to PUBLIC_BASE_URL when empty.
phipster_METADATA_CONTACT=

# Client build-time values (Vite reads this root .env file).
# Create a Spotify app and register this exact redirect URI.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=https://bibster.tallgin.com/spotify/callback
VITE_PUBLIC_BASE_URL=https://bibster.tallgin.com
